{
  "name": "starparis-worker",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply starparis-dev --local",
    "migrate:dev": "wrangler d1 migrations apply starparis-dev --remote",
    "migrate:staging": "wrangler d1 migrations apply starparis-staging --remote --env staging"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261102.1",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.156.2"
  }
}
